{
  "name": "jianpu-studio",
  "private": true,
  "version": "1.0.0",
  "description": "简谱打谱、播放、MIDI 与五线谱互转工具",
  "author": "Jianpu Studio",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "electron:dev": "node scripts/electron-dev.mjs",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:mac:zip": "vite build && electron-builder --mac --x64 -c.mac.target=zip",
    "dist:all": "vite build && electron-builder --win --mac"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@xmldom/xmldom": "^0.9.12",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.1",
    "vite": "^5.4.11"
  }
}
